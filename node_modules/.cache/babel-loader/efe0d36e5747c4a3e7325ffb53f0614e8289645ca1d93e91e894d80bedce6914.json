oter","jsx","_jsx","jsxs","_jsxs","Home","_ref","onNavigate","className","home","children","currentPage","section_1","content","section_2","section_3","info_box","src","require","info_image","alt","info_content","concat","reverse","section_4"],"sources":["/Users/branimiryanchev/Documents/GitHub/Filiya/src/pages/Home/Home.jsx"],"sourcesContent":["import React from 'react';\nimport styles from './Home.module.scss';\nimport Carousel from './Carousel/Carousel';\nimport Navbar from '../../components/Navbar/Navbar';\nimport Contacts from './Contacts/Contacts';\nimport Footer from '../../components/Footer/Footer';\n\nexport default function Home({ onNavigate }) {\n  return (\n    <div className={styles.home}>\n      <Navbar currentPage=\"home\" onNavigate={onNavigate} />\n      <section className={styles.section_1}>\n        <div className={styles.content}>\n          <h1>φιλία</h1>\n          <p>Добре дошли във социалната мрежа</p>\n        </div>\n      </section>\n      <section className={styles.section_2}>\n        <div className={styles.content}>\n          <h1>Най-популярни постове</h1>\n          <Carousel />\n        </div>\n      </section>\n      <section className={styles.section_3}>\n        <div className={styles.content}>\n          <h1>Информация</h1>\n          <div className={styles.info_box}>\n            <img src={require(\"./Carousel/images/img1.png\")} className={styles.info_image} alt=\"Информация 1\" />\n            <div className={styles.info_content}>\n              <h2>Заглавие 1</h2>\n              <p>Това е място, където ще откриете вдъхновяващи истории, полезни съвети и красиви моменти, споделени от хора по целия свят. Потопете се в разнообразни теми – от пътешествия и кулинария до личностно развитие и изкуство. Всяка публикация носи емоция и ново знание.</p>\n            </div>\n          </div>\n          <div className={`${styles.info_box} ${styles.reverse}`}>\n            <img src={require(\"./Carousel/images/img2.png\")} className={styles.info_image} alt=\"Информация 2\" />\n            <div className={styles.info_content}>\n              <h2>Заглавие 2</h2>\n              <p>Това е място, където ще откриете вдъхновяващи истории, полезни съвети и красиви моменти, споделени от хора по целия свят. Потопете се в разнообразни теми – от пътешествия и кулинария до личностно развитие и изкуство. Всяка публикация носи емоция и ново знание.</p>\n            </div>\n          </div>\n          <div className={styles.info_box}>\n            <img src={require(\"./Carousel/images/img3.png\")} className={styles.info_image} alt=\"Информация 3\" />\n            <div className={styles.info_content}>\n              <h2>Заглавие 3</h2>\n              <p>Това е място, където ще откриете вдъхновяващи истории, полезни съвети и красиви моменти, споделени от хора по целия свят. Потопете се в разнообразни теми – от пътешествия и кулинария до личностно развитие и изкуство. Всяка публикация носи емоция и ново знание.</p>\n            </div>\n          </div>\n        </div>\n      </section>\n      <section className={styles.section_4}>\n        <div className={styles.content}>\n          <h1>Контакти</h1>\n          <Contacts/>\n        </div>\n      </section>\n      <Footer />\n    </div>\n  );\n}\n"],"mappings":"AAAA,MAAO,CAAAA,KAAK,KAAM,OAAO,CACzB,MAAO,CAAAC,MAAM,KAAM,oBAAoB,CACvC,MAAO,CAAAC,QAAQ,KAAM,qBAAqB,CAC1C,MAAO,CAAAC,MAAM,KAAM,gCAAgC,CACnD,MAAO,CAAAC,QAAQ,KAAM,qBAAqB,CAC1C,MAAO,CAAAC,MAAM,KAAM,gCAAgC,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAEpD,cAAe,SAAS,CAAAC,IAAIA,CAAAC,IAAA,CAAiB,IAAhB,CAAEC,UAAW,CAAC,CAAAD,IAAA,CACzC,mBACEF,KAAA,QAAKI,SAAS,CAAEZ,MAAM,CAACa,IAAK,CAAAC,QAAA,eAC1BR,IAAA,CAACJ,MAAM,EAACa,WAAW,CAAC,MAAM,CAACJ,UAAU,CAAEA,UAAW,CAAE,CAAC,cACrDL,IAAA,YAASM,SAAS,CAAEZ,MAAM,CAACgB,SAAU,CAAAF,QAAA,cACnCN,KAAA,QAAKI,SAAS,CAAEZ,MAAM,CAACiB,OAAQ,CAAAH,QAAA,eAC7BR,IAAA,OAAAQ,QAAA,CAAI,gCAAK,CAAI,CAAC,cACdR,IAAA,MAAAQ,QAAA,CAAG,8KAAgC,CAAG,CAAC,EACpC,CAAC,CACC,CAAC,cACVR,IAAA,YAASM,SAAS,CAAEZ,MAAM,